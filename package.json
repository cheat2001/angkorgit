{
  "name": "angkorgit",
  "version": "0.1.0",
  "private": true,
  "description": "AngKorGit — a modern, fast, beautiful cross-platform Git client inspired by the craftsmanship of Angkor Wat.",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @angkorgit/desktop dev",
    "tauri": "pnpm --filter @angkorgit/desktop tauri",
    "tauri:dev": "pnpm --filter @angkorgit/desktop tauri dev",
    "tauri:build": "pnpm --filter @angkorgit/desktop tauri build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
