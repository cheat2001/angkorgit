---
import { SITE } from '../lib/site';
import Splash from '../components/Splash.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
const baseUrl = new URL(import.meta.env.BASE_URL, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = Astro.props.ogImage ?? new URL('./og.png', baseUrl).toString() + '?v=4';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  alternateName: SITE.alternateNames,
  url: baseUrl.toString(),
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'Git client',
  operatingSystem: 'macOS, Windows, Linux',
  description,
  softwareVersion: SITE.latestVersion,
  downloadUrl: SITE.releases,
  license: SITE.license,
  sameAs: [SITE.repo],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: {
    '@type': 'Organization',
    name: 'AngKorGit contributors',
    logo: new URL(import.meta.env.BASE_URL + 'icon.png', Astro.site).toString(),
  },
  image: ogImage,
  screenshot: [
    'graph',
    'diff',
    'command-palette',
    'welcome',
    'theme-setting',
    'ai-config-setting',
    'shortcut-key',
  ].map((name) => new URL(import.meta.env.BASE_URL + `screenshots/${name}.webp`, Astro.site).toString()),
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  alternateName: SITE.alternateNames,
  url: baseUrl.toString(),
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="NdyAgOjPU__fIGnKyiKYAu59roXvOhrRmhuKvg6s56A" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" id="theme-color" content="#0C111C" />

    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + 'favicon.svg'} />
    <link rel="apple-touch-icon" href={import.meta.env.BASE_URL + 'icon.png'} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href={new URL('sitemap-index.xml', baseUrl).toString()} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteLd)} />

    <script is:inline>
      (() => {
        const stored = localStorage.getItem('angkorgit-theme');
        const theme = stored === 'light' ? 'light' : 'dark';
        const root = document.documentElement;
        root.classList.toggle('dark', theme === 'dark');
        root.classList.toggle('light', theme === 'light');
        const meta = document.getElementById('theme-color');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#0C111C' : '#F5F7F9');
      })();
    </script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const seen = sessionStorage.getItem('angkorgit-splash');
          if (seen === '1' || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            root.classList.add('no-splash');
          } else {
            sessionStorage.setItem('angkorgit-splash', '1');
          }
        } catch {
          root.classList.add('no-splash');
        }
      })();
    </script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('reveal-ready');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const reveal = () => {
          const els = Array.from(document.querySelectorAll('[data-reveal]'));
          if (!('IntersectionObserver' in window)) {
            els.forEach((el) => el.classList.add('is-revealed'));
            return;
          }
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-revealed');
                  io.unobserve(entry.target);
                }
              }
            },
            { rootMargin: '0px 0px -10% 0px', threshold: 0.08 },
          );
          els.forEach((el) => io.observe(el));
        };
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', reveal);
        } else {
          reveal();
        }
      })();
    </script>
  </head>
  <body class="bg-background text-foreground">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground"
    >
      Skip to content
    </a>
    <slot />
    <Splash />
  </body>
</html>
