---
import Logo from './Logo.astro';
import { SITE } from '../lib/site';
---

<footer class="relative overflow-hidden border-t border-border-subtle">
  <svg
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-6 left-1/2 h-40 w-[64rem] -translate-x-1/2 text-primary opacity-[0.07]"
    viewBox="0 0 640 160"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linejoin="round"
  >
    <path d="M320 10 L300 70 L300 160 M320 10 L340 70 L340 160" />
    <path d="M220 40 L205 90 L205 160 M220 40 L235 90 L235 160" />
    <path d="M420 40 L405 90 L405 160 M420 40 L435 90 L435 160" />
    <path d="M120 70 L110 110 L110 160 M120 70 L130 110 L130 160" />
    <path d="M520 70 L510 110 L510 160 M520 70 L530 110 L530 160" />
    <path d="M0 160 H640" />
  </svg>

  <div class="container-site rail-offset relative grid gap-12 py-16 md:grid-cols-[1.6fr_1fr_1fr]">
    <div class="space-y-5">
      <a href="/" class="flex items-center gap-2.5">
        <Logo size={28} class="text-foreground" />
        <span class="display text-2xl">AngKorGit</span>
      </a>
      <p class="max-w-sm text-[15px] leading-relaxed text-muted">
        Built by one person who wanted a Git client that gets out of the way. MIT licensed, no telemetry, no account. If it saves
        you time,
        <a href={SITE.buyMeACoffee} target="_blank" rel="noreferrer" class="link-underline text-foreground">buy me a coffee</a>.
      </p>
    </div>

    <div>
      <h3 class="font-mono text-xs uppercase tracking-[0.14em] text-faint">Project</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-muted">
        <li><a class="transition-colors hover:text-foreground" href={SITE.repo}>Source code</a></li>
        <li><a class="transition-colors hover:text-foreground" href={SITE.releases}>Releases and changelog</a></li>
        <li><a class="transition-colors hover:text-foreground" href="/docs/">Documentation</a></li>
        <li><a class="transition-colors hover:text-foreground" href="/docs/roadmap/">Roadmap</a></li>
        <li><a class="transition-colors hover:text-foreground" href={SITE.ci}>CI status</a></li>
      </ul>
    </div>

    <div>
      <h3 class="font-mono text-xs uppercase tracking-[0.14em] text-faint">Taking part</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-muted">
        <li><a class="transition-colors hover:text-foreground" href={`${SITE.repo}/issues`}>Report a bug</a></li>
        <li><a class="transition-colors hover:text-foreground" href={SITE.contributing}>Contributing</a></li>
        <li><a class="transition-colors hover:text-foreground" href={SITE.codeOfConduct}>Code of conduct</a></li>
        <li><a class="transition-colors hover:text-foreground" href={SITE.security}>Security</a></li>
        <li><a class="transition-colors hover:text-foreground" href={SITE.license}>License</a></li>
      </ul>
    </div>
  </div>

  <div class="relative border-t border-border-subtle">
    <div class="container-site rail-offset flex flex-col items-start justify-between gap-2 py-6 font-mono text-xs text-faint sm:flex-row sm:items-center">
      <p>© {new Date().getFullYear()} AngKorGit · MIT</p>
      <p>Tauri 2 · Rust · libgit2 · React</p>
    </div>
  </div>
</footer>
