---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV, SITE } from '../lib/site';
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-border-subtle/70 bg-background/80 backdrop-blur-md"
>
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5" aria-label="AngKorGit home">
      <Logo size={30} class="text-foreground" />
      <span class="text-[15px] font-semibold tracking-tight">AngKorGit</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        NAV.map((item) => (
          <a href={item.href} class="nav-link">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={SITE.repo}
        target="_blank"
        rel="noreferrer"
        aria-label="View source on GitHub"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border text-muted transition-colors hover:bg-surface-raised hover:text-foreground"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.49 5.92.43.37.82 1.11.82 2.24v3.32c0 .32.22.7.83.58A11.99 11.99 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"
          />
        </svg>
      </a>
      <ThemeToggle />

      <a
        href="/#install"
        class="hidden items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:opacity-90 sm:inline-flex"
      >
        Download
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 5v14m0 0 6-6m-6 6-6-6" />
        </svg>
      </a>

      <button
        id="nav-menu-button"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-menu"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border text-muted transition-colors hover:bg-surface-raised hover:text-foreground lg:hidden"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="nav-menu" class="hidden border-t border-border-subtle bg-background lg:hidden">
    <nav class="container-site flex flex-col gap-1 py-4" aria-label="Mobile">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="rounded-md px-3 py-2.5 text-sm text-muted transition-colors hover:bg-surface-raised hover:text-foreground"
          >
            {item.label}
          </a>
        ))
      }      <a
        href="/#install"
        class="mt-2 inline-flex items-center justify-center gap-2 rounded-md bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground"
      >
        Download AngKorGit
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const menuButton = document.getElementById('nav-menu-button');
  const menu = document.getElementById('nav-menu');
  menuButton?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  menu?.querySelectorAll('a').forEach((link) =>
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      menuButton?.setAttribute('aria-expanded', 'false');
    }),
  );

  const onScroll = () => {
    header?.classList.toggle('scrolled', window.scrollY > 8);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('nav a'));

  const docsLinks = navLinks.filter((link) => new URL(link.href).pathname.startsWith('/docs'));
  if (location.pathname.startsWith('/docs')) {
    docsLinks.forEach((link) => {
      link.classList.add('nav-active');
      link.setAttribute('aria-current', 'page');
    });
  }

  const sectionLinks = navLinks.filter((link) => link.getAttribute('href')?.startsWith('/#'));
  const sections = sectionLinks
    .map((link) => ({ link, section: document.getElementById(link.getAttribute('href')!.slice(2)) }))
    .filter((entry): entry is { link: HTMLAnchorElement; section: HTMLElement } => Boolean(entry.section));
  if ('IntersectionObserver' in window && sections.length > 0) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const { link, section } of sections) {
            const active = section.id === entry.target.id;
            link.classList.toggle('nav-active', active);
            if (active) link.setAttribute('aria-current', 'page');
            else link.removeAttribute('aria-current');
          }
        }
      },
      { rootMargin: '-30% 0px -60% 0px', threshold: 0 },
    );
    sections.forEach(({ section }) => io.observe(section));
  }
</script>

<style>
  header {
    transition:
      box-shadow 200ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  header.scrolled {
    border-color: hsl(var(--border));
    box-shadow: 0 12px 32px -24px hsl(var(--foreground) / 0.18);
  }
  .nav-active {
    background: hsl(var(--surface-raised));
    color: hsl(var(--foreground));
  }
</style>
