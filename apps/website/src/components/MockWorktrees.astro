---
const tabs = [
  { name: 'angkorgit', worktree: false, active: false },
  { name: 'angkorgit-fix-login', worktree: true, active: true },
  { name: 'angkorgit-agent', worktree: true, active: false },
];
const trees = [
  { name: 'angkorgit', branch: 'main', main: true, current: false, dirty: false },
  { name: 'angkorgit-fix-login', branch: 'fix/login-redirect', main: false, current: true, dirty: true },
  { name: 'angkorgit-agent', branch: 'agent/refactor-watcher', main: false, current: false, dirty: true },
];
---

<div class="mock mock-scale min-w-[34rem] font-sans">
  <div class="flex h-9 items-stretch border-b border-border-subtle bg-surface-raised/60 px-2">
    {
      tabs.map((tab) => (
        <span
          class:list={[
            'relative mt-1.5 flex items-center gap-1.5 rounded-t-md px-3 text-[11px]',
            tab.active ? 'bg-surface text-foreground shadow-[0_-1px_0_hsl(var(--border-subtle))_inset]' : 'text-muted',
          ]}
        >
          {tab.worktree && (
            <svg class="h-3 w-3 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1h-2.5a1 1 0 0 1-.8-.4l-.9-1.2A1 1 0 0 0 15 3h-2a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1Z" />
              <path d="M20 21a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1h-2.9a1 1 0 0 1-.88-.55l-.42-.85a1 1 0 0 0-.92-.6H13a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1Z" />
              <path d="M3 5a2 2 0 0 0 2 2h3M3 3v13a2 2 0 0 0 2 2h3" />
            </svg>
          )}
          {tab.name}
          {tab.active && <span class="absolute inset-x-0 -bottom-px h-0.5 rounded-full bg-primary"></span>}
        </span>
      ))
    }
    <span class="ml-1 mt-1.5 flex w-7 items-center justify-center text-faint">+</span>
  </div>

  <div class="grid grid-cols-[13.5rem_1fr]">
    <div class="border-r border-border-subtle py-2">
      <div class="flex h-7 items-center gap-1.5 px-3 text-[10px] font-medium uppercase tracking-[0.12em] text-muted">
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        Branches
        <span class="ml-auto rounded bg-surface-raised px-1.5 text-[9.5px] tabular-nums">14</span>
      </div>
      <div class="flex h-7 items-center gap-1.5 px-3 text-[10px] font-medium uppercase tracking-[0.12em] text-foreground">
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        Worktrees
        <span class="ml-auto rounded bg-surface-raised px-1.5 text-[9.5px] tabular-nums">3</span>
        <span class="text-faint">+</span>
      </div>
      <ul class="px-1.5">
        {
          trees.map((t) => (
            <li class:list={['flex items-center gap-2 rounded-md px-2 py-1.5', t.current && 'bg-surface-raised']}>
              <span class="w-3 text-[10px] text-primary">{t.current ? '✓' : ''}</span>
              <span class="flex min-w-0 flex-1 flex-col leading-tight">
                <span class="flex items-center gap-1.5 text-[11px] text-foreground">
                  <span class="truncate">{t.name}</span>
                  {t.main && (
                    <svg class="h-3 w-3 shrink-0 text-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 11 9-8 9 8v9a2 2 0 0 1-2 2h-3v-6H8v6H5a2 2 0 0 1-2-2Z" /></svg>
                  )}
                  {t.dirty && <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>}
                </span>
                <span class="truncate font-mono text-[9.5px] text-faint">{t.branch}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="p-3">
      <div class="rounded-lg border border-border-subtle bg-background p-3">
        <p class="text-[9.5px] uppercase tracking-[0.14em] text-faint">New worktree</p>
        <div class="mt-2 flex gap-1 rounded-md bg-surface-raised p-0.5 text-[10.5px]">
          <span class="flex-1 rounded bg-surface px-2 py-1 text-center text-foreground shadow-sm">New branch</span>
          <span class="flex-1 px-2 py-1 text-center text-muted">Existing branch</span>
        </div>
        <label class="mt-3 block text-[10px] text-muted">Branch name</label>
        <div class="mt-1 rounded-md border border-primary bg-surface px-2 py-1.5 font-mono text-[11px] text-foreground">fix/login-redirect<span class="ml-px inline-block h-3 w-px translate-y-0.5 bg-primary"></span></div>
        <label class="mt-3 block text-[10px] text-muted">Folder</label>
        <div class="mt-1 flex items-center gap-2 rounded-md border border-border bg-surface px-2 py-1.5 font-mono text-[10.5px] text-muted">
          <span class="truncate">~/code/<span class="text-foreground">angkorgit-fix-login</span></span>
          <span class="ml-auto shrink-0 rounded border border-border px-1.5 text-[9.5px]">Browse</span>
        </div>
        <p class="mt-2 text-[9.5px] leading-snug text-faint">A sibling folder next to the main checkout. Ignored files like node_modules are not copied.</p>
        <div class="mt-3 flex items-center justify-between">
          <span class="flex items-center gap-1.5 text-[10px] text-muted">
            <span class="flex h-3 w-3 items-center justify-center rounded-[3px] bg-primary text-primary-foreground">
              <svg class="h-2 w-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            </span>
            Open it in a new tab
          </span>
          <span class="rounded-md bg-primary px-2.5 py-1 text-[10.5px] font-medium text-primary-foreground">Create</span>
        </div>
      </div>
    </div>
  </div>
</div>
