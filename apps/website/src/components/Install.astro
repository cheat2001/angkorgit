---
import Commit from './Commit.astro';
import TerminalBlock from './TerminalBlock.astro';
import { SITE } from '../lib/site';

const version = SITE.latestVersion;

const platforms = [
  {
    name: 'macOS',
    detail: 'Intel and Apple Silicon, one file',
    asset: `AngKorGit_${version}_universal.dmg`,
    note: 'Not signed with an Apple certificate, so macOS asks once. Right-click, Open, or use Homebrew below and it never asks.',
  },
  {
    name: 'Windows',
    detail: 'x64 installer',
    asset: `AngKorGit_${version}_x64-setup.exe`,
    note: 'SmartScreen will say the publisher is unknown. More info, then Run anyway. An .msi is on the releases page too.',
  },
  {
    name: 'Linux',
    detail: 'AppImage, .deb and .rpm',
    asset: `AngKorGit_${version}_amd64.AppImage`,
    note: 'chmod +x and run. Needs WebKitGTK 4.1 and libssl, which most desktops already have.',
  },
];

const brew = 'brew install --cask cheat2001/tap/angkorgit';
---

<Commit id="install" class="py-20 lg:py-28">
  <div class="container-site rail-offset">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="min-w-0 lg:col-span-5" data-reveal>
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-primary">Install · v{version}</p>
        <h2 class="display mt-3 text-4xl leading-[1.02] sm:text-5xl">Pick your platform.</h2>
        <p class="mt-6 text-[17px] leading-relaxed text-muted">
          Every build is compiled in public by GitHub Actions from the source you can read, and the app checks for
          the next version itself.
        </p>
        <div class="mt-8">
          <p class="font-mono text-xs uppercase tracking-[0.14em] text-faint">Mac with Homebrew</p>
          <div class="mt-2">
            <TerminalBlock label="terminal" lines={[brew]} copy={brew} />
          </div>
        </div>
      </div>

      <div class="min-w-0 lg:col-span-7" data-reveal style={{ '--reveal-delay': '120ms' }}>
        <ul class="divide-y divide-border-subtle border-y border-border-subtle">
          {
            platforms.map((p) => (
              <li class="grid gap-4 py-6 sm:grid-cols-[7rem_1fr_auto] sm:items-start">
                <div>
                  <h3 class="text-lg font-medium tracking-tight text-foreground">{p.name}</h3>
                  <p class="mt-0.5 text-xs text-faint">{p.detail}</p>
                </div>
                <div class="min-w-0">
                  <p class="truncate font-mono text-[12px] text-muted">{p.asset}</p>
                  <p class="mt-2 text-[13px] leading-relaxed text-muted">{p.note}</p>
                </div>
                <a
                  href={SITE.assetUrl(version, p.asset)}
                  class="inline-flex h-9 items-center gap-2 self-start rounded-md border border-border px-3.5 text-sm font-medium text-foreground transition-colors hover:border-primary hover:text-primary"
                >
                  Download
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 5v14m0 0 6-6m-6 6-6-6" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>

        <details class="group mt-6">
          <summary class="flex cursor-pointer list-none items-center gap-2 text-sm text-muted hover:text-foreground">
            <svg class="h-3.5 w-3.5 transition-transform group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
            Install from the terminal without Homebrew
          </summary>
          <div class="mt-4 grid gap-4">
            <TerminalBlock
              label="macOS"
              lines={[
                `curl -L ${SITE.assetUrl(version, `AngKorGit_${version}_universal.dmg`)} -o ~/Downloads/AngKorGit.dmg`,
                'xattr -cr ~/Downloads/AngKorGit.dmg',
                'open ~/Downloads/AngKorGit.dmg',
              ]}
              copy={`curl -L ${SITE.assetUrl(version, `AngKorGit_${version}_universal.dmg`)} -o ~/Downloads/AngKorGit.dmg && xattr -cr ~/Downloads/AngKorGit.dmg && open ~/Downloads/AngKorGit.dmg`}
            />
            <TerminalBlock
              label="Windows (PowerShell)"
              lines={[
                `curl -L ${SITE.assetUrl(version, `AngKorGit_${version}_x64-setup.exe`)} -o "$env:TEMP\\AngKorGit-setup.exe"`,
                `Start-Process "$env:TEMP\\AngKorGit-setup.exe"`,
              ]}
              copy={`curl -L ${SITE.assetUrl(version, `AngKorGit_${version}_x64-setup.exe`)} -o "$env:TEMP\\AngKorGit-setup.exe"; Start-Process "$env:TEMP\\AngKorGit-setup.exe"`}
            />
            <TerminalBlock
              label="Linux"
              lines={[
                `curl -L ${SITE.assetUrl(version, `AngKorGit_${version}_amd64.AppImage`)} -o ~/Downloads/AngKorGit.AppImage`,
                'chmod +x ~/Downloads/AngKorGit.AppImage',
                '~/Downloads/AngKorGit.AppImage',
              ]}
              copy={`curl -L ${SITE.assetUrl(version, `AngKorGit_${version}_amd64.AppImage`)} -o ~/Downloads/AngKorGit.AppImage && chmod +x ~/Downloads/AngKorGit.AppImage && ~/Downloads/AngKorGit.AppImage`}
            />
          </div>
        </details>

        <p class="mt-6 text-sm text-muted">
          Something odd on first launch? The <a href="/docs/getting-started/" class="link-underline text-foreground">getting started page</a>
          walks through each prompt. All versions are on the <a href={SITE.releases} class="link-underline text-foreground">releases page</a>.
        </p>
      </div>
    </div>
  </div>
</Commit>
