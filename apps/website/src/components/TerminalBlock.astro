---
interface Props {
  label: string;
  code: string;
}

const { label, code } = Astro.props;
---

<div class="terminal-block">
  <div class="flex items-center gap-2 rounded-t-md border border-b-0 border-border-subtle bg-surface-raised px-3 py-2">
    <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
    <span class="ml-2 font-mono text-xs text-faint">{label}</span>
    <button
      type="button"
      data-copy
      data-copy-target={code}
      aria-label={`Copy ${label} install command`}
      class="ml-auto inline-flex items-center gap-1.5 rounded-md border border-border px-2.5 py-1 font-mono text-xs text-muted transition-colors hover:bg-surface hover:text-foreground"
    >
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-copy-icon>
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
      </svg>
      <span data-copy-label>Copy</span>
    </button>
  </div>
  <pre class="overflow-x-auto whitespace-pre-wrap rounded-b-md border border-border-subtle bg-black/40 p-4 font-mono text-[12px] leading-relaxed text-foreground"><code>{code}</code></pre>
</div>

<script>
  const blocks = document.querySelectorAll('.terminal-block');

  blocks.forEach((block) => {
    const button = block.querySelector<HTMLButtonElement>('[data-copy]');
    const label = block.querySelector<HTMLElement>('[data-copy-label]');
    const icon = block.querySelector<SVGElement>('[data-copy-icon]');

    button?.addEventListener('click', async () => {
      const code = button.dataset.copyTarget ?? '';
      try {
        await navigator.clipboard.writeText(code);
      } catch {
        const textarea = document.createElement('textarea');
        textarea.value = code;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        textarea.remove();
      }

      if (label && icon) {
        label.textContent = 'Copied!';
        icon.innerHTML =
          '<path d="M20 6 9 17l-5-5" />';
        button.classList.add('border-primary', 'text-primary');

        setTimeout(() => {
          label.textContent = 'Copy';
          icon.innerHTML =
            '<rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />';
          button.classList.remove('border-primary', 'text-primary');
        }, 2000);
      }
    });
  });
</script>
