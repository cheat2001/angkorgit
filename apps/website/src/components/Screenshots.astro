---
const base = import.meta.env.BASE_URL;

const shots = [
  {
    src: base + 'screenshots/graph.webp',
    width: 1800,
    height: 1130,
    alt: 'AngKorGit commit graph in the Angkor Dusk theme with branches and working copy',
    caption: 'Virtualized graph with animated lanes, refs, tags, and the working copy at hand.',
    featured: true,
  },
  {
    src: base + 'screenshots/diff.webp',
    width: 1600,
    height: 1004,
    alt: 'AngKorGit side-by-side diff with commit details',
    caption: 'Side-by-side diffs — word-level highlights, minimap, line-level staging.',
  },
  {
    src: base + 'screenshots/command-palette.webp',
    width: 1400,
    height: 879,
    alt: 'AngKorGit ⌘K command palette',
    caption: 'The ⌘K command palette — every action searchable, keyboard-first by design.',
  },
  {
    src: base + 'screenshots/welcome.webp',
    width: 1400,
    height: 879,
    alt: 'AngKorGit welcome screen with recent repositories',
    caption: 'Open, clone, or return to recent projects.',
  },
  {
    src: base + 'screenshots/theme-setting.webp',
    width: 1400,
    height: 879,
    alt: 'AngKorGit appearance settings with theme and accent colors',
    caption: 'Sixteen themes, five accent colors, and UI zoom — all in one settings tab.',
  },
  {
    src: base + 'screenshots/ai-config-setting.webp',
    width: 1400,
    height: 879,
    alt: 'AngKorGit AI settings with provider configuration',
    caption: 'AI settings — bring your own provider, or use an AI CLI you already have with no API key at all.',
  },
  {
    src: base + 'screenshots/shortcut-key.webp',
    width: 1400,
    height: 879,
    alt: 'AngKorGit keyboard shortcuts overview',
    caption: 'Shortcuts render next to every action — the full keyboard reference lives in settings.',
  },
];

const featured = shots.filter((shot) => shot.featured);
const grid = shots.filter((shot) => !shot.featured);
---

<section id="gallery" class="section-pad scroll-mt-20 border-t border-border-subtle bg-surface">
  <div class="container-site">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">Gallery</p>
      <h2 class="h2-section">Beautiful at any scale</h2>
      <p class="lede">
        A focused interface: graph in the center, working copy on the right, terminal docked below.
        Angkor Dusk by default, fifteen more themes when you want them. Click any screenshot to zoom in.
      </p>
    </div>

    <div class="mt-14 grid gap-8">
      {
        featured.map((shot, i) => (
          <figure
            class="group screenshot-figure"
            data-reveal
            style={{ '--reveal-delay': `${i * 80}ms` }}
          >
            <button
              type="button"
              class="block w-full cursor-zoom-in overflow-hidden rounded-lg border border-border-subtle bg-surface-raised text-left shadow-soft transition-all duration-200 hover:border-border group-hover:shadow-lg"
              data-screenshot
            >
              <span class="flex items-center gap-1.5 border-b border-border-subtle px-4 py-2.5">
                <span class="h-2 w-2 rounded-full bg-danger/70" aria-hidden="true"></span>
                <span class="h-2 w-2 rounded-full bg-amber-400/70" aria-hidden="true"></span>
                <span class="h-2 w-2 rounded-full bg-success/70" aria-hidden="true"></span>
                <span class="ml-3 hidden font-mono text-xs text-faint sm:inline">main — AngKorGit</span>
              </span>
              <img
                src={shot.src}
                alt={shot.alt}
                width={shot.width}
                height={shot.height}
                loading="lazy"
                decoding="async"
                class="pointer-events-none hidden h-auto w-full dark:block"
                data-screenshot-img
              />
              <img
                src={shot.src.replace('.webp', '-light.webp')}
                alt={shot.alt}
                width={shot.width}
                height={shot.height}
                loading="lazy"
                decoding="async"
                class="pointer-events-none block h-auto w-full dark:hidden"
                data-screenshot-img
              />
            </button>
            <figcaption class="mt-3 text-sm text-muted">{shot.caption}</figcaption>
          </figure>
        ))
      }

      <div class="grid gap-8 md:grid-cols-2">
        {
          grid.map((shot, i) => (
            <figure
              class="group screenshot-figure"
              data-reveal
              style={{ '--reveal-delay': `${(i % 2) * 80}ms` }}
            >
              <button
                type="button"
                class="block w-full cursor-zoom-in overflow-hidden rounded-lg border border-border-subtle bg-surface-raised text-left shadow-soft transition-all duration-200 hover:border-border group-hover:shadow-lg"
                data-screenshot
              >
                <span class="flex items-center gap-1.5 border-b border-border-subtle px-4 py-2.5">
                  <span class="h-2 w-2 rounded-full bg-danger/70" aria-hidden="true"></span>
                  <span class="h-2 w-2 rounded-full bg-amber-400/70" aria-hidden="true"></span>
                  <span class="h-2 w-2 rounded-full bg-success/70" aria-hidden="true"></span>
                </span>
                <img
                  src={shot.src}
                  alt={shot.alt}
                  width={shot.width}
                  height={shot.height}
                  loading="lazy"
                  decoding="async"
                  class="pointer-events-none hidden h-auto w-full dark:block"
                  data-screenshot-img
                />
                <img
                  src={shot.src.replace('.webp', '-light.webp')}
                  alt={shot.alt}
                  width={shot.width}
                  height={shot.height}
                  loading="lazy"
                  decoding="async"
                  class="pointer-events-none block h-auto w-full dark:hidden"
                  data-screenshot-img
                />
              </button>
              <figcaption class="mt-3 text-sm text-muted">{shot.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<div
  id="lightbox"
  class="lightbox fixed inset-0 z-50 flex flex-col items-center justify-center bg-black/85 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Screenshot preview"
  hidden
>
  <p id="lightbox-title" class="mb-3 max-w-3xl self-center font-mono text-xs text-white/60"></p>
  <figure class="flex max-w-[92vw] flex-col items-center">
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-h-[78vh] max-w-[92vw] rounded-lg object-contain shadow-2xl ring-1 ring-white/10"
    />
    <figcaption id="lightbox-caption" class="mt-4 max-w-2xl text-center text-sm text-white/80"></figcaption>
  </figure>

  <button
    id="lightbox-prev"
    type="button"
    aria-label="Previous screenshot"
    class="absolute left-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white/90 transition-colors hover:bg-white/20 sm:left-6"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m15 18-6-6 6-6" />
    </svg>
  </button>
  <button
    id="lightbox-next"
    type="button"
    aria-label="Next screenshot"
    class="absolute right-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white/90 transition-colors hover:bg-white/20 sm:right-6"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m9 18 6-6-6-6" />
    </svg>
  </button>
  <button
    id="lightbox-close"
    type="button"
    aria-label="Close"
    class="absolute right-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white/90 transition-colors hover:bg-white/20"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M18 6 6 18M6 6l12 12" />
    </svg>
  </button>
</div>

<script>
  type Item = { srcs: [string, string]; caption: string; title: string };

  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-screenshot]'));
  const items: Item[] = buttons.map((button) => {
    const figure = button.closest<HTMLElement>('.screenshot-figure');
    const imgs = Array.from(button.querySelectorAll<HTMLImageElement>('[data-screenshot-img]'));
    const caption = figure?.querySelector<HTMLElement>('figcaption');
    return {
      srcs: [imgs[0]?.src ?? '', imgs[1]?.src ?? ''],
      caption: caption?.textContent?.trim() ?? '',
      title: button.querySelector<HTMLElement>('.sm\\:inline')?.textContent?.trim() ?? '',
    };
  });

  const lightbox = document.getElementById('lightbox');
  if (!lightbox) throw new Error('lightbox missing');
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const caption = document.getElementById('lightbox-caption') as HTMLElement;
  const title = document.getElementById('lightbox-title') as HTMLElement;
  const prev = document.getElementById('lightbox-prev');
  const next = document.getElementById('lightbox-next');
  const close = document.getElementById('lightbox-close');
  let index = 0;
  let lastFocused: HTMLElement | null = null;

  const render = (i: number) => {
    index = (i + items.length) % items.length;
    const item = items[index];
    const dark = document.documentElement.classList.contains('dark');
    img.src = dark ? item.srcs[0] : item.srcs[1];
    img.alt = item.caption;
    caption.textContent = item.caption;
    title.textContent = item.title;
  };

  const open = (i: number) => {
    if (items.length === 0) return;
    lastFocused = document.activeElement as HTMLElement | null;
    render(i);
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    close?.focus();
  };

  const closeLightbox = () => {
    lightbox.hidden = true;
    document.body.style.overflow = '';
    lastFocused?.focus();
  };

  buttons.forEach((button, i) => {
    button.addEventListener('click', () => open(i));
  });
  lightbox.addEventListener('click', (event) => {
    if (event.target === lightbox) closeLightbox();
  });
  close?.addEventListener('click', closeLightbox);
  prev?.addEventListener('click', () => render(index - 1));
  next?.addEventListener('click', () => render(index + 1));
  document.addEventListener('keydown', (event) => {
    if (lightbox.hidden) return;
    if (event.key === 'Escape') closeLightbox();
    if (event.key === 'ArrowLeft') render(index - 1);
    if (event.key === 'ArrowRight') render(index + 1);
  });
</script>
