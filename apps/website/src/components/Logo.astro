---
interface Props {
  size?: number;
  class?: string;
  animated?: boolean;
}

const { size = 28, animated = false } = Astro.props;
const draw = animated
  ? { strokeDasharray: 300, strokeDashoffset: 300, animation: 'angkor-draw 1.6s cubic-bezier(0.6, 0, 0.2, 1) forwards' }
  : undefined;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  class={Astro.props.class}
  role="img"
  aria-label="AngKorGit"
>
  <g stroke="#D97706" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style={draw}>
    <path d="M32 6 L27 20 L27 30 L37 30 L37 20 Z" />
    <path d="M16 16 L12.5 26 L12.5 34 L19.5 34 L19.5 26 Z" />
    <path d="M48 16 L44.5 26 L44.5 34 L51.5 34 L51.5 26 Z" />
  </g>
  <g stroke="currentColor" stroke-width="3" stroke-linecap="round" fill="none" style={draw}>
    <path d="M16 40 C16 48 24 46 32 46" />
    <path d="M48 40 C48 48 40 46 32 46" />
    <path d="M32 36 V 54" />
  </g>
  <circle cx="16" cy="38" r="3.5" fill="#D97706" />
  <circle cx="48" cy="38" r="3.5" fill="#D97706" />
  <circle cx="32" cy="57" r="3.5" fill="currentColor" />
</svg>
