---
interface Row {
  lane: number;
  msg: string;
  author: string;
  hash: string;
  when: string;
  through: number[];
  up: boolean;
  down: boolean;
  fromBelow?: number[];
  joinBelow?: number;
  refs?: string[];
  target?: boolean;
  wip?: boolean;
}

const rows: Row[] = [
  { lane: 0, msg: 'Uncommitted changes · 3 files', author: '', hash: '', when: '', through: [1], up: false, down: true, wip: true },
  { lane: 0, msg: 'fix(watcher): ignore lock files in worktrees', author: 'Dara', hash: '7c1e2a9', when: '2h', through: [1], up: true, down: true, refs: ['main'], target: true },
  { lane: 1, msg: 'feat(graph): author column and display menu', author: 'Mina', hash: 'b81f0d3', when: '5h', through: [0], up: true, down: true, refs: ['feat/graph'] },
  { lane: 1, msg: 'feat(graph): fixed ref column, chips fold behind +n', author: 'Mina', hash: '2d9c4e7', when: '1d', through: [0], up: true, down: false, joinBelow: 0 },
  { lane: 0, msg: 'chore(release): 0.9.0', author: 'Dara', hash: '8c89a87', when: '3d', through: [], up: true, down: true, refs: ['v0.9.0'] },
  { lane: 0, msg: 'feat(git): cherry-pick origin references (#4)', author: 'Ravi', hash: 'e713fa3', when: '4d', through: [], up: true, down: true },
];

const H = 30;
const CY = 15;
const X = (lane: number) => 12 + lane * 18;
const MID = (CY + H) / 2;
const colors = ['--graph-0', '--graph-1'];
const color = (lane: number) => `hsl(var(${colors[lane]}))`;
---

<div class="mock mock-scale relative min-w-[36rem] font-sans">
  <div class="mock-bar">
    <span class="text-[10px] uppercase tracking-[0.12em] text-faint">Graph</span>
    <span class="ml-3 inline-flex h-5 items-center gap-1.5 rounded-md border border-border bg-background px-2 text-[10px] text-muted">
      <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      Search or paste a hash
    </span>
    <span class="ml-auto inline-flex h-5 items-center gap-1 rounded-md border border-border px-1.5 text-[10px] text-muted">
      <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h10M4 18h6" /></svg>
      Display
    </span>
  </div>
  <div class="grid grid-cols-[6.5rem_1fr_5.5rem_3.5rem_2.5rem] items-center border-b border-border-subtle px-2 text-[9.5px] uppercase tracking-[0.12em] text-faint">
    <span class="py-1.5">Branch / tag</span><span class="py-1.5 pl-1">Message</span><span class="py-1.5">Author</span><span class="py-1.5">Hash</span><span class="py-1.5 text-right">Date</span>
  </div>
  <ol class="py-1">
    {
      rows.map((row) => (
        <li
          class:list={[
            'relative grid h-[30px] grid-cols-[6.5rem_1fr_5.5rem_3.5rem_2.5rem] items-center px-2 text-[11px]',
            row.wip && 'text-muted',
            row.target && 'bg-primary/10 shadow-[inset_0_0_0_1px_hsl(var(--primary)/0.5)]',
          ]}
        >
          <span class="flex items-center gap-1">
            {row.refs?.map((ref) => (
              <span
                class:list={[
                  'inline-flex h-[18px] max-w-full items-center gap-1 truncate rounded-md border px-1.5 font-mono text-[9.5px]',
                  ref.startsWith('v') ? 'border-primary/40 bg-primary/10 text-primary' : 'border-success/40 bg-success/10 text-success',
                ]}
              >
                {ref === 'main' && <span class="text-[9px]">✓</span>}
                {ref}
              </span>
            ))}
          </span>
          <span class="flex min-w-0 items-center">
            <svg width="48" height={H} viewBox={`0 0 48 ${H}`} fill="none" aria-hidden="true" class="mr-2 shrink-0">
              {row.through.map((l) => <path d={`M${X(l)} 0 V${H}`} stroke={color(l)} stroke-width="2" />)}
              {row.up && <path d={`M${X(row.lane)} 0 V${CY}`} stroke={color(row.lane)} stroke-width="2" />}
              {row.down && <path d={`M${X(row.lane)} ${CY} V${H}`} stroke={color(row.lane)} stroke-width="2" />}
              {row.joinBelow !== undefined && (
                <path d={`M${X(row.lane)} ${CY} C ${X(row.lane)} ${MID}, ${X(row.joinBelow)} ${MID}, ${X(row.joinBelow)} ${H}`} stroke={color(row.lane)} stroke-width="2" />
              )}
              {row.wip ? (
                <circle cx={X(row.lane)} cy={CY} r="5" stroke={color(row.lane)} stroke-width="2" stroke-dasharray="3 3" fill="hsl(var(--surface))" />
              ) : (
                <>
                  <rect x={X(row.lane)} y={CY - 7} width={48 - X(row.lane)} height="14" rx="7" fill={color(row.lane)} opacity="0.14" />
                  <circle cx={X(row.lane)} cy={CY} r="7.5" fill="hsl(var(--surface))" />
                  <circle cx={X(row.lane)} cy={CY} r="6" stroke={color(row.lane)} stroke-width="1.8" fill="hsl(var(--surface-raised))" />
                  <text x={X(row.lane)} y={CY + 2.5} text-anchor="middle" font-size="6.5" font-family="Inter Variable, sans-serif" font-weight="600" fill="hsl(var(--muted-foreground))">{row.author[0]}</text>
                </>
              )}
            </svg>
            <span class:list={['truncate', row.wip && 'italic']}>{row.msg}</span>
          </span>
          <span class="truncate text-[10.5px] text-muted">{row.author}</span>
          <span class="font-mono text-[10px] text-faint">{row.hash}</span>
          <span class="text-right font-mono text-[10px] text-faint">{row.when}</span>
        </li>
      ))
    }
  </ol>

  <div class="pointer-events-none absolute left-[60%] top-[5.35rem] rotate-[-3deg]">
    <span class="inline-flex h-[18px] items-center gap-1 rounded-md border border-success/50 bg-success/15 px-1.5 font-mono text-[9.5px] text-success shadow-soft">
      <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
      feat/graph
    </span>
  </div>
  <div class="pointer-events-none absolute left-[52%] top-[3.7rem] flex items-center gap-1.5 rounded-md border border-border bg-surface-overlay px-2 py-1 text-[10.5px] text-foreground shadow-soft">
    <svg class="h-3 w-3 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="18" r="3" /><circle cx="6" cy="6" r="3" /><path d="M6 21V9a9 9 0 0 0 9 9" /></svg>
    Merge <span class="font-mono text-success">feat/graph</span> into <span class="font-mono">main</span>
  </div>
  <svg class="pointer-events-none absolute left-[calc(60%+3.4rem)] top-[6rem] h-5 w-5 text-foreground drop-shadow" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M5 3l14 8.5-6.2 1.6L9.5 19z" stroke="hsl(var(--background))" stroke-width="1.5" stroke-linejoin="round" />
  </svg>
</div>
