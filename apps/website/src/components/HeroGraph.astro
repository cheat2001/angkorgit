---
interface Ref {
  label: string;
  kind: 'branch' | 'tag';
}

interface Row {
  id: string;
  lane: number;
  msg: string;
  sub?: string;
  hash?: string;
  refs?: Ref[];
  through: number[];
  up: boolean;
  down: boolean;
  fromBelow?: number[];
  joinBelow?: number;
  wip?: boolean;
}

const rows: Row[] = [
  { id: 'wip', lane: 0, msg: 'Uncommitted changes', sub: 'that part is yours', through: [], up: false, down: true, wip: true },
  {
    id: 'install',
    lane: 0,
    msg: 'Download 0.10.0',
    hash: 'c26e705',
    refs: [
      { label: 'main', kind: 'branch' },
      { label: 'v0.10.0', kind: 'tag' },
    ],
    through: [],
    up: true,
    down: true,
    fromBelow: [1],
  },
  { id: 'ai', lane: 1, msg: 'Uses the AI you already have', hash: '8f1d2c0', through: [0], up: true, down: true },
  { id: 'box', lane: 0, msg: 'Everything in the box', hash: '4a91be7', through: [1], up: true, down: true, fromBelow: [2] },
  { id: 'size', lane: 1, msg: 'Native, not a browser', hash: 'e3c07d1', through: [0, 2], up: true, down: true },
  { id: 'palette', lane: 2, msg: '⌘K, then type', hash: 'b7720af', through: [0, 1], up: true, down: true },
  { id: 'graph', lane: 2, msg: 'Drag a branch onto another', hash: '19de4c2', through: [0, 1], up: true, down: false, joinBelow: 0 },
  {
    id: 'worktrees',
    lane: 1,
    msg: 'Two branches, two folders',
    hash: '0c5a3f9',
    refs: [{ label: 'feat/worktrees', kind: 'branch' }],
    through: [0],
    up: true,
    down: false,
    joinBelow: 0,
  },
  { id: 'conflicts', lane: 0, msg: 'Conflicts you can read', hash: 'd41ab88', through: [], up: true, down: true },
  { id: 'why', lane: 0, msg: 'init: why I made this', hash: 'a1b2c3d', through: [], up: true, down: false },
];

const H = 46;
const CY = 23;
const X = (lane: number) => 12 + lane * 20;
const MID = (CY + H) / 2;
const laneColor = ['--graph-0', '--graph-1', '--graph-3'];
const color = (lane: number) => `hsl(var(${laneColor[lane]}))`;
---

<div class="hg select-none" aria-label="Table of contents drawn as a commit graph" role="navigation">
  <div class="mock-bar rounded-t-lg border border-border">
    <span class="h-2 w-2 rounded-full" style="background:hsl(var(--graph-0) / 0.8)"></span>
    <span class="font-mono text-[10.5px] tracking-wide text-faint">angkorgit.app</span>
    <span class="ml-auto font-mono text-[10.5px] text-faint">{rows.length - 1} commits</span>
  </div>
  <ol class="overflow-hidden rounded-b-lg border border-t-0 border-border bg-surface py-1">
    {
      rows.map((row, i) => (
        <li>
          <a
            href={row.wip ? '#install' : `#${row.id}`}
            data-hg-row={row.id}
            class="hg-row group flex items-center gap-2 pr-3 transition-colors hover:bg-surface-raised aria-[current=true]:bg-primary/10"
            style={{ '--i': i, height: `${H}px` }}
          >
            <svg width="72" height={H} viewBox={`0 0 72 ${H}`} fill="none" aria-hidden="true" class="shrink-0">
              {row.through.map((l) => (
                <path d={`M${X(l)} 0 V${H}`} stroke={color(l)} stroke-width="2" />
              ))}
              {row.up && <path d={`M${X(row.lane)} 0 V${CY}`} stroke={color(row.lane)} stroke-width="2" />}
              {row.down && <path d={`M${X(row.lane)} ${CY} V${H}`} stroke={color(row.lane)} stroke-width="2" />}
              {row.fromBelow?.map((o) => (
                <path
                  d={`M${X(o)} ${H} C ${X(o)} ${MID}, ${X(row.lane)} ${MID}, ${X(row.lane)} ${CY}`}
                  stroke={color(o)}
                  stroke-width="2"
                />
              ))}
              {row.joinBelow !== undefined && (
                <path
                  d={`M${X(row.lane)} ${CY} C ${X(row.lane)} ${MID}, ${X(row.joinBelow)} ${MID}, ${X(row.joinBelow)} ${H}`}
                  stroke={color(row.lane)}
                  stroke-width="2"
                />
              )}
              {row.wip ? (
                <circle cx={X(row.lane)} cy={CY} r="6" stroke={color(row.lane)} stroke-width="2" stroke-dasharray="3 3" fill="hsl(var(--background))" />
              ) : (
                <g class="transition-transform duration-200 group-hover:scale-110" style={`transform-origin:${X(row.lane)}px ${CY}px`}>
                  <circle cx={X(row.lane)} cy={CY} r="8.5" fill="hsl(var(--background))" />
                  <circle cx={X(row.lane)} cy={CY} r="6.5" stroke={color(row.lane)} stroke-width="2" fill="hsl(var(--surface))" />
                  <circle cx={X(row.lane)} cy={CY} r="2.75" fill={color(row.lane)} />
                </g>
              )}
            </svg>
            <span class="flex min-w-0 flex-1 items-center gap-2">
              {row.refs?.map((ref) => (
                <span
                  class:list={[
                    'inline-flex h-5 shrink-0 items-center gap-1 rounded-md border px-1.5 font-mono text-[10px]',
                    ref.kind === 'tag'
                      ? 'border-primary/40 bg-primary/10 text-primary'
                      : 'border-success/40 bg-success/10 text-success',
                  ]}
                >
                  {ref.kind === 'tag' ? (
                    <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 2H2v10l9.29 9.29a1 1 0 0 0 1.42 0l8.58-8.58a1 1 0 0 0 0-1.42L12 2Z" />
                      <path d="M7 7h.01" />
                    </svg>
                  ) : (
                    <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect width="20" height="14" x="2" y="3" rx="2" />
                      <path d="M8 21h8M12 17v4" />
                    </svg>
                  )}
                  {ref.label}
                </span>
              ))}
              <span
                class:list={[
                  'truncate text-[13px]',
                  row.wip ? 'italic text-muted' : 'text-foreground group-hover:text-primary',
                ]}
              >
                {row.msg}
              </span>
              {row.sub && <span class="hidden truncate text-[11px] text-faint sm:inline">{row.sub}</span>}
            </span>
            <span class="hidden shrink-0 items-center gap-3 font-mono text-[10.5px] text-faint sm:flex">
              {row.hash && <span class="tabular-nums">{row.hash}</span>}
              <span class="w-8 text-right">{row.wip ? '' : i === 1 ? 'now' : `${i}m`}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
  <p class="mt-3 text-center font-mono text-[10.5px] text-faint">
    Newest on top, like a real graph. Click a commit to jump.
  </p>
</div>
