---
import Commit from './Commit.astro';

interface Props {
  id: string;
  lane: number;
  kicker: string;
  title: string;
  flip?: boolean;
}

const { id, lane, kicker, title, flip = false } = Astro.props;
---

<Commit id={id} lane={lane} dotTopSm="4rem" class="py-16 lg:py-24">
  <div class="container-site rail-offset">
    <div class:list={['grid items-center gap-10 lg:grid-cols-12', flip && 'lg:[&>*:first-child]:order-2']}>
      <div class="min-w-0 lg:col-span-5" data-reveal>
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-primary">{kicker}</p>
        <h2 class="display mt-3 text-4xl leading-[1.02] sm:text-5xl" set:html={title} />
        <div class="mt-6 space-y-4 text-[17px] leading-relaxed text-muted">
          <slot name="body" />
        </div>
      </div>
      <div class="min-w-0 overflow-x-auto pb-1 lg:col-span-7" data-reveal style={{ '--reveal-delay': '120ms' }}>
        <slot name="mock" />
      </div>
    </div>
  </div>
</Commit>
